# Copy the values into your terminal/session before starting Spring Boot.
# Do NOT enter secrets in this file. It is only a naming reference.
SUPABASE_DB_URL=jdbc:postgresql://db.<your-project-ref>.supabase.co:5432/postgres?sslmode=require
SUPABASE_DB_USERNAME=postgres
SUPABASE_DB_PASSWORD=<your-database-password>
# Optional: a different React development-server origin.
CORS_ALLOWED_ORIGIN=http://localhost:5173
